{
  "name": "wowhelp",
  "version": "0.1.0",
  "private": true,
  "description": "WoWHelp: assistente para jogadores de World of Warcraft Retail (web, PWA e addon Companion).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @wowhelp/web",
    "build": "npm run build -w @wowhelp/web",
    "start": "npm run start -w @wowhelp/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @wowhelp/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
