# Copie para .env.local e preencha. Nunca commite .env.local.
# Local: rode `npx supabase start` na raiz e use `npx supabase status -o env`
# (API_URL, PUBLISHABLE_KEY e SECRET_KEY). Em preview/produção: chaves do
# projeto Supabase do WoWHelp (conta própria), nas variáveis de ambiente da Vercel.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site, usada nos links de confirmação de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Segredos: só no servidor, nunca com prefixo NEXT_PUBLIC_.
# Chave secreta do Supabase (grava dados da Battle.net, do addon e do catálogo).
SUPABASE_SECRET_KEY=
# Cliente da Battle.net (develop.battle.net). Sem eles, a conexão aparece como indisponível.
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# Protege a rota que importa o catálogo oficial (chamada pelo GitHub Actions).
CRON_SECRET=
# Comunidade BR ("ao vivo agora"). Sem nenhuma delas, a página mostra o aviso de "em breve".
# Twitch: dev.twitch.tv/console (app do tipo Confidential).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: Google Cloud, chave restrita à YouTube Data API v3.
YOUTUBE_API_KEY=
# Kick: kick.com/settings/developer (precisa de verificação em duas etapas).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Anúncios (Google AdSense). Sem o client, não há anúncio nem aviso de cookies.
# Não são segredos: aparecem na página. Blocos = números criados no painel do AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY=

# Stripe (assinatura WoWHelp Apoiador). Chave secreta sk_test_ (teste) ou
# sk_live_ (cobrança real) e o segredo do aviso de pagamento (whsec_). Cadastre
# na Vercel com scripts/cadastrar-chave-vercel.ps1; nunca no chat nem no git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
