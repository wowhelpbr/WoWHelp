# Copie para .env.local e preencha. Nunca commite .env.local.
# Local: rode `npx supabase start` na raiz e use `npx supabase status -o env`
# (API_URL e PUBLISHABLE_KEY). Em preview/produção: chaves do projeto Supabase
# do WoWHelp (conta própria), configuradas nas variáveis de ambiente da Vercel.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site, usada nos links de confirmação de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Nunca usar prefixo NEXT_PUBLIC_ para segredos (secret key, service role,
# Battle.net client secret). Eles entram só na Fase 2, no servidor.
